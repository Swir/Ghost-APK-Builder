data class AppSettings(
    val defaultSubscriptionId: Int = SubscriptionManager.INVALID_SUBSCRIPTION_ID,
    val confirmBeforeSend: Boolean = true,
    val biometricLock: Boolean = false
)

class SettingsStore(context: Context) {
    private val prefs = context.getSharedPreferences("swirsms_settings_v3", Context.MODE_PRIVATE)

    fun load(): AppSettings = AppSettings(
        defaultSubscriptionId = prefs.getInt("default_subscription_id", SubscriptionManager.INVALID_SUBSCRIPTION_ID),
        confirmBeforeSend = prefs.getBoolean("confirm_before_send", true),
        biometricLock = prefs.getBoolean("biometric_lock", false)
    )

    fun save(settings: AppSettings) {
        prefs.edit()
            .putInt("default_subscription_id", settings.defaultSubscriptionId)
            .putBoolean("confirm_before_send", settings.confirmBeforeSend)
            .putBoolean("biometric_lock", settings.biometricLock)
            .apply()
    }
}


data class Recipient(val name: String, val number: String)

data class HistoryEntry(
    val id: Long,
    val timestamp: Long,
    val recipientName: String,
    val recipientNumber: String,
    val text: String,
    val simLabel: String,
    val status: String,
    val details: String,
    val source: String = "Ręcznie"
)

class HistoryStore(context: Context) {
    private val prefs = context.applicationContext.getSharedPreferences("swirsms_history_v3", Context.MODE_PRIVATE)

    fun load(): List<HistoryEntry> = runCatching {
        val array = JSONArray(prefs.getString("items", "[]") ?: "[]")
        buildList {
            for (i in 0 until array.length()) {
                val o = array.getJSONObject(i)
                add(
                    HistoryEntry(
                        id = o.optLong("id"),
                        timestamp = o.optLong("timestamp"),
                        recipientName = o.optString("recipientName"),
                        recipientNumber = o.optString("recipientNumber"),
                        text = o.optString("text"),
                        simLabel = o.optString("simLabel", "SIM"),
                        status = o.optString("status", "KOLEJKA"),
                        details = o.optString("details"),
                        source = o.optString("source", "Ręcznie")
                    )
                )
            }
        }
    }.getOrElse { emptyList() }

    @Synchronized
    fun add(entry: HistoryEntry): List<HistoryEntry> {
        val updated = (listOf(entry) + load().filterNot { it.id == entry.id }).take(300)
        persist(updated)
        return updated
    }

    @Synchronized
    fun update(id: Long, status: String, details: String): List<HistoryEntry> {
        val updated = load().map {
            if (it.id == id) it.copy(status = status, details = details) else it
        }
        persist(updated)
        return updated
    }

    @Synchronized
    fun recordPart(id: Long, kind: String, success: Boolean, partCount: Int, detail: String) {
        if (!success) {
            update(id, "BŁĄD", detail)
            prefs.edit().putBoolean("failed_$id", true).apply()
            return
        }
        if (prefs.getBoolean("failed_$id", false)) return

        val key = "${kind}_count_$id"
        val count = prefs.getInt(key, 0) + 1
        prefs.edit().putInt(key, count).apply()
        if (count >= partCount) {
            when (kind) {
                "sent" -> update(id, "WYSŁANO", "Operator przyjął wszystkie części SMS do wysłania.")
                "delivered" -> update(id, "DOSTARCZONO", "Sieć potwierdziła dostarczenie wszystkich części wiadomości.")
            }
        }
    }

    fun clear() = prefs.edit().clear().apply()

    private fun persist(items: List<HistoryEntry>) {
        val array = JSONArray()
        items.forEach { item ->
            array.put(JSONObject().apply {
                put("id", item.id)
                put("timestamp", item.timestamp)
                put("recipientName", item.recipientName)
                put("recipientNumber", item.recipientNumber)
                put("text", item.text)
                put("simLabel", item.simLabel)
                put("status", item.status)
                put("details", item.details)
                put("source", item.source)
            })
        }
        prefs.edit().putString("items", array.toString()).apply()
    }
}


data class SmsTemplate(val id: Long, val name: String, val text: String)

class TemplateStore(context: Context) {
    private val prefs = context.getSharedPreferences("swirsms_templates_v3", Context.MODE_PRIVATE)

    fun load(): List<SmsTemplate> = runCatching {
        val a = JSONArray(prefs.getString("items", "[]") ?: "[]")
        buildList {
            for (i in 0 until a.length()) {
                val o = a.getJSONObject(i)
                add(SmsTemplate(o.optLong("id"), o.optString("name"), o.optString("text")))
            }
        }
    }.getOrElse { emptyList() }

    fun add(name: String, text: String): List<SmsTemplate> {
        val item = SmsTemplate(System.currentTimeMillis(), name.trim().ifBlank { "Szablon" }, text)
        val updated = (listOf(item) + load()).take(50)
        persist(updated)
        return updated
    }

    fun delete(id: Long): List<SmsTemplate> {
        val updated = load().filterNot { it.id == id }
        persist(updated)
        return updated
    }

    private fun persist(items: List<SmsTemplate>) {
        val a = JSONArray()
        items.forEach { a.put(JSONObject().put("id", it.id).put("name", it.name).put("text", it.text)) }
        prefs.edit().putString("items", a.toString()).apply()
    }
}


