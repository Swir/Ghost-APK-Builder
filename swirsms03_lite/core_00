data class AppSettings(
    val defaultSubscriptionId: Int = SubscriptionManager.INVALID_SUBSCRIPTION_ID,
    val confirmBeforeSend: Boolean = true,
    val biometricLock: Boolean = false
)

class SettingsStore(context: Context) {
    private val prefs = context.getSharedPreferences("swirsms_settings_v3", Context.MODE_PRIVATE)
    fun load() = AppSettings(
        prefs.getInt("default_subscription_id", SubscriptionManager.INVALID_SUBSCRIPTION_ID),
        prefs.getBoolean("confirm_before_send", true),
        prefs.getBoolean("biometric_lock", false)
    )
    fun save(value: AppSettings) {
        prefs.edit()
            .putInt("default_subscription_id", value.defaultSubscriptionId)
            .putBoolean("confirm_before_send", value.confirmBeforeSend)
            .putBoolean("biometric_lock", value.biometricLock)
            .apply()
    }
}

data class Recipient(val name: String, val number: String)

data class HistoryEntry(
    val id: Long,
    val timestamp: Long,
    val recipientName: String,
    val recipientNumber: String,
    val text: String,
    val simLabel: String,
    val status: String,
    val details: String
)

class HistoryStore(context: Context) {
    private val prefs = context.applicationContext.getSharedPreferences("swirsms_history_v3", Context.MODE_PRIVATE)

    fun load(): List<HistoryEntry> = runCatching {
        val a = JSONArray(prefs.getString("items", "[]") ?: "[]")
        buildList {
            for (i in 0 until a.length()) {
                val o = a.getJSONObject(i)
                add(HistoryEntry(
                    o.optLong("id"), o.optLong("timestamp"), o.optString("recipientName"),
                    o.optString("recipientNumber"), o.optString("text"), o.optString("simLabel", "SIM"),
                    o.optString("status", "KOLEJKA"), o.optString("details")
                ))
            }
        }
    }.getOrElse { emptyList() }

    @Synchronized fun add(item: HistoryEntry) {
        persist((listOf(item) + load().filterNot { it.id == item.id }).take(300))
    }

    @Synchronized fun update(id: Long, status: String, details: String) {
        persist(load().map { if (it.id == id) it.copy(status = status, details = details) else it })
    }

