        prefs.edit().putString("items", a.toString()).apply()
    }
}

data class RecipientGroup(val id: Long, val name: String, val recipients: List<Recipient>)
class GroupStore(context: Context) {
    private val prefs = context.getSharedPreferences("swirsms_groups_v3", Context.MODE_PRIVATE)
    fun load(): List<RecipientGroup> = runCatching {
        val a = JSONArray(prefs.getString("items", "[]") ?: "[]")
        buildList {
            for (i in 0 until a.length()) {
                val o = a.getJSONObject(i); val rs = o.optJSONArray("recipients") ?: JSONArray()
                val rec = buildList { for (j in 0 until rs.length()) rs.getJSONObject(j).let { add(Recipient(it.optString("name"), it.optString("number"))) } }
                add(RecipientGroup(o.optLong("id"), o.optString("name"), rec))
            }
        }
    }.getOrElse { emptyList() }
    fun add(name: String, recipients: List<Recipient>) {
        persist((listOf(RecipientGroup(System.currentTimeMillis(), name.ifBlank { "Grupa" }, recipients.take(20))) + load()).take(30))
    }
    fun delete(id: Long) = persist(load().filterNot { it.id == id })
    private fun persist(items: List<RecipientGroup>) {
        val a = JSONArray(); items.forEach { g ->
            val rs = JSONArray(); g.recipients.forEach { rs.put(JSONObject().put("name", it.name).put("number", it.number)) }
            a.put(JSONObject().put("id", g.id).put("name", g.name).put("recipients", rs))
        }
        prefs.edit().putString("items", a.toString()).apply()
    }
}

