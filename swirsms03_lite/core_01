        val a = JSONArray(prefs.getString("items", "[]") ?: "[]")
        buildList { for (i in 0 until a.length()) a.getJSONObject(i).let { add(SmsTemplate(it.optLong("id"), it.optString("name"), it.optString("text"))) } }
    }.getOrElse { emptyList() }
    fun add(name: String, text: String) {
        persist((listOf(SmsTemplate(System.currentTimeMillis(), name.ifBlank { "Szablon" }, text)) + load()).take(50))
    }
    fun delete(id: Long) = persist(load().filterNot { it.id == id })
